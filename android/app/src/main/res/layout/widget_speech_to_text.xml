<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_speech_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp"
    android:background="@android:color/transparent"
    android:contentDescription="@string/speech_to_text_widget_label">

    <ImageView
        android:id="@+id/widget_speech_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/widget_speech_to_text_background"
        android:contentDescription="@string/speech_to_text_widget_label"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_mic" />
</FrameLayout>
