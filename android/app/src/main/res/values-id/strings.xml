    <string name="gallery_cleaner_manage_media_title">Izinkan sampah tanpa diminta</string>
    <string name="gallery_cleaner_manage_media_message">Secara default Android meminta untuk mengonfirmasi setiap penghapusan.\n\nAktifkan aplikasi ini di bawah:\nPengaturan → Akses aplikasi khusus →\n\nAkses foto saja tidak cukup. \"Buka tautan yang didukung\" adalah pengaturan yang berbeda.</string>
