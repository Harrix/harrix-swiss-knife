(site) {
	encode gzip zstd

	# Reserved for FastAPI (search / sync). Enable api profile and uncomment:
	# handle /api/* {
	# 	request_body {
	# 		max_size 64KB
	# 	}
	# 	reverse_proxy api:8000 {
	# 		header_up X-Real-IP {client_ip}
	# 	}
	# }

	handle {
		root * /srv
		try_files {path} {path}/ {path}.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	log {
		output stdout
		format console
	}
}

# Cloudflare Origin CA certificate (SSL mode "Full" / "Full (strict)")
{$DOMAIN:harrix.dev}, www.{$DOMAIN:harrix.dev} {
	tls /certs/origin.pem /certs/origin.key
	import site
}

# Plain HTTP without redirect, so Cloudflare "Flexible" mode cannot loop
http://{$DOMAIN:harrix.dev}, http://www.{$DOMAIN:harrix.dev} {
	import site
}
