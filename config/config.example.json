{
  "beginning_of_article": "snippet:config/beginning-of-article.md",
  "beginning_of_md": "snippet:config/beginning-of-md.md",
  "beginning_of_md_docs": "snippet:config/beginning-of-md-en.md",
  "block_drives": [],
  "cli_commands": "snippet:config/cli-commands.md",
  "combine_for_ai_unchecked_extensions": [
    "svg",
    "png",
    "jpg",
    "jpeg",
    "gif",
    "webp",
    "ico",
    "bmp",
    "tiff",
    "woff2",
    "stl"
  ],
  "combine_for_ai_unchecked_files": [
    "dist/*.*",
    "src/favicon/*.*",
    "README.md",
    "LICENSE.md",
    "attribution.yaml",
    "api-keys/**",
    "purgecss.config.js"
  ],
  "compact_mode": false,
  "hotkeys": [
    {
      "action": "OnQuickLauncher",
      "hotkeys": ["Ctrl+Shift+F1"]
    },
    {
      "action": "OnScreenshotRegion",
      "hotkeys": ["Ctrl+Shift+F2"]
    }
  ],
  "quick_launcher_markdown_in_panel": true,
  "editor": "cursor",
  "editor-notes": "code-insiders",
  "food_calorie_thresholds": {
    "low": 1800,
    "medium_high": 2500,
    "medium_low": 2100
  },
  "apps": {
    "initial_count": 1000,
    "load_more_count": 500
  },
  "android_build_variant": "release",
  "optimize_images_folder_max_size": 1024,
  "food_log_translate_names_limit": 250,
  "finance_transactions_translate_descriptions_limit": 250,
  "finance_standard_items_translate_names_limit": 250,
  "github_user": "Harrix",
  "harrix_notes_explorer_publisher": "harrix",
  "markdown_templates": {
    "☕ Coffee": {
      "commit_message_template": "☕ Add coffee note \"{Title}\" in {City}",
      "dialog_links": [
        {
          "label": "Google Maps",
          "url": "https://www.google.com/maps"
        },
        {
          "label": "Yandex Maps",
          "url": "https://yandex.ru/maps"
        },
        {
          "label": "OpenStreetMap",
          "url": "https://www.openstreetmap.org"
        },
        {
          "label": "2GIS",
          "url": "https://2gis.ru/"
        }
      ],
      "edit_existing": true,
      "note_with_images": true,
      "path_layout": "city_note",
      "path_target": "<YOUR_TEMPLATE_TARGET_PATH>",
      "template_file": "config/template-coffee.md"
    },
    "✈️ Travel": {
      "commit_message_template": "➕ Add travel \"{Title}\"",
      "dialog_links": [
        {
          "label": "Booking",
          "url": "https://www.booking.com/"
        },
        {
          "label": "Google Maps",
          "url": "https://www.google.com/maps"
        }
      ],
      "image_max_size": 1024,
      "image_optimize": true,
      "insert_position": "start",
      "path_target": "<YOUR_TEMPLATE_TARGET_PATH>",
      "template_file": "config/template-travel.md"
    },
    "🎬 Movie": {
      "commit_message_template": "🎬 Add movie \"{TitleEnglish}\"",
      "dialog_links": [
        {
          "label": "IMDb",
          "url": "https://www.imdb.com"
        },
        {
          "label": "Kinopoisk",
          "url": "https://www.kinopoisk.ru"
        }
      ],
      "insert_position": "start",
      "path_target": "<YOUR_TEMPLATE_TARGET_PATH>",
      "template_file": "config/template-movie.md"
    },
    "🎭 Events": {
      "commit_message_template": "➕ Add event \"{Title}\"",
      "dialog_links": [
        {
          "label": "Afisha",
          "url": "https://afisha.yandex.ru/"
        },
        {
          "label": "Kassir",
          "url": "https://www.kassir.ru/"
        }
      ],
      "image_max_size": 1024,
      "image_optimize": true,
      "insert_position": "start",
      "path_target": "<YOUR_TEMPLATE_TARGET_PATH>",
      "template_file": "config/template-event.md"
    },
    "📖 Book": {
      "commit_message_template": "➕ Add book \"{TitleEnglish}\" {AuthorEnglish}",
      "dialog_links": [
        {
          "label": "Wikipedia (en)",
          "url": "https://en.wikipedia.org/wiki/Main_Page"
        },
        {
          "label": "Fantlab",
          "url": "https://fantlab.ru/"
        }
      ],
      "insert_position": "start",
      "path_target": "<YOUR_TEMPLATE_TARGET_PATH>",
      "template_file": "config/template-book.md"
    },
    "📺 Movie: series": {
      "commit_message_template": "🎬 Add series \"{TitleEnglish}\" (season {Season})",
      "dialog_links": [
        {
          "label": "IMDb",
          "url": "https://www.imdb.com"
        },
        {
          "label": "Kinopoisk",
          "url": "https://www.kinopoisk.ru"
        }
      ],
      "insert_position": "start",
      "path_target": "<YOUR_TEMPLATE_TARGET_PATH>",
      "template_file": "config/template-series.md"
    }
  },
  "note_beginning_templates": [
    "snippet:config/beginning-of-md.md",
    "snippet:config/beginning-of-article.md",
    "snippet:config/beginning-of-md-en.md"
  ],
  "npm_packages": ["npm-check-updates", "prettier"],
  "path_3d": "<YOUR_DOWNLOADS_FOLDER>",
  "path_articles": "<YOUR_ARTICLES_FOLDER>",
  "path_books": "<YOUR_BOOKS_FOLDER>",
  "path_cases": "<YOUR_CASES_FOLDER>",
  "path_diary": "<YOUR_DIARY_FOLDER>",
  "path_dream": "<YOUR_DREAM_FOLDER>",
  "path_memories": "<YOUR_MEMORIES_FOLDER>",
  "path_github": "<YOUR_GITHUB_FOLDER>",
  "path_harrix_notes_explorer": "<YOUR_HARRIX_NOTES_EXPLORER_REPO>",
  "path_image_viewer": "<YOUR_IMAGE_VIEWER_EXE>",
  "path_last_note_folder": "<YOUR_LAST_NOTE_FOLDER>",
  "path_notes": "<YOUR_NOTES_FOLDER>",
  "path_photos": "<YOUR_PHOTOS_FOLDER>",
  "path_quotes": "<YOUR_QUOTES_FOLDER>",
  "path_totalcmd_ini": "<YOUR_TOTALCMD_WINCMD_INI>",
  "paths_combine_for_ai": [
    {
      "base_folder": "<YOUR_GITHUB_FOLDER>/harrix-swiss-knife",
      "files": ["<YOUR_GITHUB_FOLDER>/harrix-swiss-knife/src/**/*.py"],
      "name": "example-project"
    }
  ],
  "paths_git": ["<YOUR_PATH>"],
  "paths_notes": ["<YOUR_PATH>"],
  "paths_notes_for_summaries": ["<YOUR_PATH>"],
  "paths_android_projects": ["<YOUR_GITHUB_FOLDER>/harrix-swiss-knife/android"],
  "paths_python_libraries": ["<YOUR_GITHUB_FOLDER>/harrix-pylib", "<YOUR_GITHUB_FOLDER>/harrix-pyssg"],
  "paths_python_project_creation": ["<YOUR_PATH>"],
  "paths_python_projects": ["<YOUR_GITHUB_FOLDER>/harrix-swiss-knife"],
  "paths_quotes": ["<YOUR_PATH>"],
  "paths_sites": [
    {
      "input": "<YOUR_SITE_CONTENT>",
      "output": "<YOUR_SITE_OUTPUT>"
    }
  ],
  "path_site_repo": "<YOUR_SITE_GIT_REPO>",
  "site_name": "harrix.dev",
  "github_user": "Harrix",
  "site_default_language": "ru",
  "paths_with_featured_image": ["<YOUR_PATH>"],
  "bothub": {
    "base_url": "https://bothub.chat/api/v2/openai/v1",
    "model": "gpt-5.4",
    "speech_model": "gemini-3.1-flash-lite-preview",
    "max_image_side": 1600,
    "proxy": ""
  },
  "bothub_api_key": "snippet:api-keys/bothub-api-key.txt",
  "prompts": {
    "finance_purchases_to_tsv": "snippet:config/prompts/finance-purchases-to-tsv.md",
    "finance_category_translate_local": "snippet:config/prompts/finance-category-translate-local.md",
    "finance_transactions_translate_descriptions": "snippet:config/prompts/finance-transactions-translate-descriptions.md",
    "finance_standard_items_translate_names": "snippet:config/prompts/finance-standard-items-translate-names.md",
    "food_log_to_tsv": "snippet:config/prompts/food-log-to-tsv.md",
    "food_voice_log_to_tsv": "snippet:config/prompts/food-voice-log-to-tsv.md",
    "food_kcal_lookup": "snippet:config/prompts/food-kcal-lookup.md",
    "food_portion_weight_from_calories": "snippet:config/prompts/food-portion-weight-from-calories.md",
    "food_log_translate_names": "snippet:config/prompts/food-log-translate-names.md",
    "text_fix_ru": "snippet:config/prompts/text-fix-ru.md",
    "text_fix_ru_clipboard": "snippet:config/prompts/text-fix-ru-clipboard.md",
    "text_rewrite_ru": "snippet:config/prompts/text-rewrite-ru.md",
    "image_ocr_to_markdown": "snippet:config/prompts/image-ocr-to-markdown.md",
    "markdown_template_fields_from_source": "snippet:config/prompts/markdown-template-fields-from-source.md"
  },
  "pypi_token": "snippet:api-keys/pypi-token.txt",
  "show_main_window_on_startup": false,
  "sqlite_finance": "<YOUR_FINANCE_DB>",
  "sqlite_fitness": "<YOUR_FITNESS_DB>",
  "sqlite_food": "<YOUR_FOOD_DB>",
  "sqlite_habits": "<YOUR_HABITS_DB>",
  "start_pattern_jupyter_notebooks": "jupyter-notebook-",
  "start_pattern_py_projects": "python-project-",
  "vscode_workspace_articles": "<YOUR_ARTICLES_CODE_WORKSPACE>",
  "vscode_workspace_notes": "<YOUR_NOTES_CODE_WORKSPACE>"
}
